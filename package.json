{
  "name": "elysium-chain-mcp",
  "version": "0.1.1",
  "description": "MCP server so AI agents can read and interact with Elysium chain. Part of ElysiumForge Labs.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elysium",
    "kinetiq",
    "hyperliquid",
    "evm",
    "arbitrum-orbit",
    "viem"
  ],
  "type": "module",
  "bin": {
    "elysium-chain-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vitest": "~4.1.11"
  }
}
